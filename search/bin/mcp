#!/usr/bin/env bash
# search MCP 런처 — 키 파일을 읽고, 이름에 맞는 서버를 버전 고정해서 실행해요.
# Claude Code 에는 `bash <이 파일> <이름>` 으로 등록돼요 (install-mac.sh).
set -euo pipefail
KEYS="${SEARCH_KEYS:-$HOME/.config/search/keys.env}"
if [[ -f "$KEYS" ]]; then set -a; . "$KEYS"; set +a; fi

case "${1:-}" in
  naver-search) exec npx -y @isnow890/naver-search-mcp@1.1.0 ;;
  kakao-map)    exec npx -y mcp-server-kakao-map@0.3.2 ;;
  airbnb)       exec npx -y @openbnb/mcp-server-airbnb@0.3.0 ;;
  reddit)       exec npx -y reddit-mcp-buddy@1.3.0 ;;
  serpapi)      exec npx -y mcp-remote@0.16.7 https://mcp.serpapi.com/mcp \
                  --header "Authorization: Bearer ${SERPAPI_API_KEY}" ;;
  google-maps)  exec npx -y mcp-remote@0.16.7 https://mapstools.googleapis.com/mcp \
                  --header "X-Goog-Api-Key: ${GOOGLE_MAPS_API_KEY}" ;;
  fli)          exec "$HOME/.local/bin/fli-mcp" ;;
  *) echo "usage: mcp {naver-search|kakao-map|airbnb|reddit|serpapi|google-maps|fli}" >&2; exit 2 ;;
esac
