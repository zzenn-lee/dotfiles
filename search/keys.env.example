# search 도구 키 — 이 파일 하나만 채우면 돼요.
# 위치: ~/.config/search/keys.env  (install-mac.sh 가 이 예시를 복사해 만들어요. git 에 올라가지 않아요.)
# 값을 채운 뒤 install-mac.sh 를 다시 실행하면, 키가 있는 도구만 등록돼요.
# 형식: 이름=값  (따옴표·공백 없이)

# ── 네이버 검색 (naver-search) ─────────────────────────────
# 블로그·카페·뉴스·지식인·지역·DataLab. 무료(검색 하루 25,000회).
# 발급: ncloud.com 콘솔 > Services > Application Services > NAVER API HUB > Application 등록 > 인증 정보
NCP_APIGW_API_KEY_ID=
NCP_APIGW_API_KEY=
# (예전 개발자센터 키가 있으면 위 대신 이것만 채워도 돼요. 2027-06-30 까지 동작)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 카카오맵 (kakao-map) ──────────────────────────────────
# 국내 장소·주소·좌표 검색. 무료.
# 발급: developers.kakao.com > 내 애플리케이션 > 앱 추가 > REST API 키 + 카카오맵 활성화 ON
KAKAO_REST_API_KEY=

# ── 구글 검색 (serpapi) ───────────────────────────────────
# 구글 웹·쇼핑·호텔·항공·지도 결과. 무료 월 250회(초과 시 멈춤, 결제 등록 안 하면 과금 없음).
# 발급: serpapi.com 가입 > Dashboard > API Key
SERPAPI_API_KEY=

# ── 구글 지도 (google-maps) ───────────────────────────────
# 해외 장소·경로·날씨 (Maps Grounding Lite, 공식).
# 주의: Google Cloud 결제 계정이 있어야 키가 발급돼요. 원치 않으면 비워 두세요.
# 발급: console.cloud.google.com > API 및 서비스 > Maps Grounding Lite API 사용 > 사용자 인증 정보 > API 키
GOOGLE_MAPS_API_KEY=

# ── Reddit (reddit) ──────────────────────────────────────
# 주의: Reddit 이 신규 발급을 막아서, 이미 승인받은 키가 있을 때만 쓸 수 있어요.
# Reddit 은 키 없이도 last30days 가 검색해요.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── last30days 스킬 (선택) ────────────────────────────────
# 비워도 Reddit·YouTube·HN 은 동작해요.
# Instagram·Threads·TikTok: ScrapeCreators (가입 시 무료 10,000회, 다 쓰면 멈춤)
#   발급: app.scrapecreators.com — 또는 /last30days 첫 실행 때 GitHub 로그인으로 자동 발급
SCRAPECREATORS_API_KEY=
# 웹 검색 보강: Brave Search API (무료 크레딧). 발급: api-dashboard.search.brave.com
BRAVE_API_KEY=

# ── 키 필요 없음 ──────────────────────────────────────────
# airbnb (숙소), fli (구글 항공권), naver-blog (기존, 블로그 본문 읽기)
